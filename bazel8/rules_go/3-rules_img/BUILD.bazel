load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_img//img:layer.bzl", "image_layer")
load("@rules_img//img:push.bzl", "image_push")
load("@rules_img//img:image.bzl", "image_manifest", "image_index")
load("@rules_img//img:load.bzl", "image_load")

go_binary(
  name = "helloworld",
  srcs = ["main.go"],
 )


image_layer(
  name = "helloworld_layer",
  srcs = {
    "/app/helloworld" : ":helloworld",
  }
)

platform(
  name = "linux_amd_platform",
  constraint_values = [
    "@platforms//cpu:x86_64",
    "@platforms//os:linux",
  ],
)

platform(
  name = "linux_arm_platform",
  constraint_values = [
    "@platforms//cpu:arm64",
    "@platforms//os:linux",
  ],
)

image_manifest(
  name = "helloworld_manifest.amd64",
  layers = [":helloworld_layer"],
  platform = ":linux_amd_platform",
)

image_manifest(
  name = "helloworld_manifest.arm64",
  layers = [":helloworld_layer"],
  platform = ":linux_arm_platform",
)

image_index(
  name = "helloworld_index",
  manifests = [":helloworld_manifest.amd64", ":helloworld_manifest.arm64"],
)

image_push(
  name = "push_helloworld_index",
  image = ":helloworld_index",
  registry = "localhost:5000",
  repository = "bazel/helloworld",
  strategy = "lazy",
)

image_load(
  name = "load_helloworld_index",
  image = ":helloworld_index",
)